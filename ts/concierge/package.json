{
  "name": "@evinvest/concierge",
  "version": "0.1.0",
  "description": "Host wrappers for the concierge microfrontends: the sign-in dialog, the account page and the account chip, the sign-in-required hook, and the session shape. A thin layer over @evinvest/mfe.",
  "license": "BlueOak-1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EV-invest/lib.git",
    "directory": "ts/concierge"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.react.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup && tsup --config tsup.react.config.ts"
  },
  "peerDependencies": {
    "@evinvest/mfe": ">=0.1.0 <1",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@evinvest/mfe": "file:../mfe",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
